% Title, authors, affiliations
\newcommand{\ORDtitle}[1]{\def \ordtitledef{#1}}
\newcommand{\ORDshortafill}[1]{\def \ordshortafilldef{#1}}
\newcommand{\ORDshorttitle}[1]{\def \ordshorttitledef{\textit{#1}}}
\newcommand{\ORDaffilone}[1]{\def \ordaffilonedef{#1}}
\newcommand{\ORDaffiltwo}[1]{\def \ordaffiltwodef{#1}}
\newcommand{\ORDaffilthree}[1]{\def \ordaffilthreedef{#1}}
\newcommand{\ORDaffilfour}[1]{\def \ordaffilfourdef{#1}}

\newcommand{\ORDauthorone}[4]{\def \aonename{#1} \def \aoneaffil{#2} \def \aoneorcid{#3} \def \aonemail{#4}}
\newcommand{\ORDauthortwo}[4]{\def \atwoname{#1} \def \atwoaffil{#2} \def \atwoorcid{#3} \def \atwomail{#4}}
\newcommand{\ORDauthorthree}[4]{\def \athreename{#1} \def \athreeaffil{#2} \def \athreeorcid{#3} \def \athreemail{#4}}
\newcommand{\ORDauthorfour}[4]{\def \afourname{#1} \def \afouraffil{#2} \def \afourorcid{#3} \def \afourmail{#4}}
\newcommand{\ORDauthorfive}[4]{\def \afivename{#1} \def \afiveaffil{#2} \def \afiveorcid{#3} \def \afivemail{#4}}
\newcommand{\ORDauthorsix}[4]{\def \asixname{#1} \def \asixaffil{#2} \def \asixorcid{#3} \def \asixmail{#4}}
\def \asixname{}
\def \asixaffil{}
\def \asixorcid{}
\def \asixmail{}

\newcommand{\ORDcorrespoding}[2]{\def \ordcorrespondingtext{#1} \def \ordcorrespondingdef{#2}}

\newcommand{\ORDvolume}[1]{\def \ordvolumedef{#1}}
\newcommand{\ORDnumber}[1]{\def \ordnumberdef{#1}}
\newcommand{\ORDyear}[1]{\def \ordyeardef{#1}}
\newcommand{\ORDdoi}[1]{\def \orddoidef{#1}}
\newcommand{\ORDReceived}[1]{\def \ordreceiveddef{#1}}
\newcommand{\ORDRevised}[1]{\def \ordreviseddef{#1}}
